#
# APP
#
NODE_ENV=local
PORT=3001
HOST=localhost

#
# DATABASE
#
DB_USERNAME=db_username
DB_PASSWORD=db_user_password
DB_HOST=localhost
DB_PORT=db_port
DB_NAME=db_name
DB_DIALECT=pg
DB_POOL_MIN=2
DB_POOL_MAX=10

#
# HASHING
#
SALT_LENGTH=16

#
# JWT
#
JWT_SECRET=this_is_a_super_secret_jwt_key_that_is_at_least_64_characters_long
JWT_EXPIRES_IN=24h
JWT_ALG=HS256

#
# AWS
#
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

#
# BEDROCK
#
BEDROCK_MODEL_ID=model_id

#
# EMBEDDING
#
EMBEDDING_MODEL_ID=Xenova/bge-m3
EMBEDDING_S3_BUCKET=promptomat-models
EMBEDDING_S3_PREFIX=bge-m3/
EMBEDDING_LOCAL_PATH=./.model-cache
EMBEDDING_DIMENSIONS=1024

#
# MAIL SERVICE
#
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=your_ethereal_user
MAIL_PASSWORD=your_ethereal_password
MAIL_FROM=no-reply@promptomat.local
#
# Password reset link
PASSWORD_RESET_LINK_BASE_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=10
#
